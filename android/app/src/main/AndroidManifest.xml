<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Web pages, and sign-in and sync with the shared Zero-Trust account. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <!-- Download progress and "Download complete" notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Only asked for when a site wants them and you said yes to that
         site (video calls, maps, scanning QR codes). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Whether Android's Private DNS (encrypted DNS) is on (B17). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Audio and read aloud keep playing with the app in the background,
         with play and pause in the notification (B26, B27). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Downloads keep going with the app in the background (B34). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.location" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application
        android:label="ZT Browser"
        android:supportsRtl="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true">
        <!-- Plain http is allowed at the platform level so a site the user
             agreed to open insecurely (or a LAN device) can load; the
             browser's own HTTPS-only mode decides, and asks first. -->
        <!-- No usage statistics from the web engine to Google. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.APP_BROWSER"/>
            </intent-filter>
            <!-- Links are handled by the app's own code (supabase_flutter's app_links, and the
                 native link handling in MainActivity), not Flutter's router: AppGate has no
                 route for them. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
            <!-- Password-reset emails: https://zerotrust.bz/auth/browser/?code=… (see EmailLinks). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="zerotrust.bz" android:pathPrefix="/auth/browser/"/>
            </intent-filter>
            <!-- Links from other apps; lets ZT Browser be the default browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- "Share to ZT Browser" for a link or text, and selected text. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter android:label="@string/search_in_app">
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- QR scanner (ZXing): any orientation, not just landscape. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Media notification: page audio and read aloud (B26, B27). -->
        <service
            android:name=".MediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Downloads in the background, with progress, Pause and Cancel (B34). -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Opening or sharing a private download: a temporary plain copy (B33). -->
        <provider
            android:name=".PrivateFiles"
            android:authorities="${applicationId}.privatefiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/private_download_paths" />
        </provider>
        <!-- Home screen search bar widget (W12). -->
        <receiver
            android:name=".SearchWidgetProvider"
            android:label="@string/search_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_widget_info" />
        </receiver>
        <!-- W13: quick links grid and the 1x1 Fire button. -->
        <receiver
            android:name=".LinksWidgetProvider"
            android:label="@string/links_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/links_widget_info" />
        </receiver>
        <service
            android:name=".LinksWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <receiver
            android:name=".FireWidgetProvider"
            android:label="@string/fire_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fire_widget_info" />
        </receiver>
    </application>
    <queries>
        <!-- B40: "Send to ZT Notes" hands a download straight to ZT Notes. -->
        <package android:name="dev.sagron.zerotrustnotes"/>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Opening mailto:, tel:, maps and app links in other apps. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Voice search, and naming the password manager in Settings. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
        <intent>
            <action android:name="android.service.autofill.AutofillService"/>
        </intent>
        <!-- Read aloud: the phone's text-to-speech engines. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- Save to the other ZT apps (B25), only when installed. -->
        <package android:name="dev.sagron.zerotrustnotes"/>
        <package android:name="dev.sagron.zerotrusttasks"/>
        <package android:name="dev.sagron.zerotrustphone"/>
        <package android:name="dev.sagron.zerotrustcontacts"/>
    </queries>
</manifest>
