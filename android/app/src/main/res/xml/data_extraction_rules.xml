<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the download vault (B39), the encrypted download
     list (B37) and private downloads stay on this phone, never in a cloud
     backup or a transfer to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault/" />
        <exclude domain="file" path="secure/" />
        <exclude domain="file" path="private-downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault/" />
        <exclude domain="file" path="secure/" />
        <exclude domain="file" path="private-downloads/" />
    </device-transfer>
</data-extraction-rules>
